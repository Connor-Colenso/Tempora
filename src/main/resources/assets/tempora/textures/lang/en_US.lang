# === Regions ===
tempora.region.not_found=No region is called '%s'. Use /tempora region list to see them all.
tempora.region.rules=Rules: %s
tempora.region.rules.none=No rules, so this region doesn't change what gets logged.
tempora.region.dimension_banner=-- Regions in %s (ID %s) --

tempora.command.region.create.description=Creates a named region between two corner blocks, both included. Coordinates can be relative to you, e.g. ~-50. On its own a region changes nothing, use /tempora region set to turn loggers on or off inside it.
tempora.command.region.create.arg0=Unique name for the region, used by the other region commands.
tempora.command.region.create.arg1=First corner block. ~ means your own position.
tempora.command.region.create.arg2=Opposite corner block.
tempora.command.region.create.arg3=Optional. Dimension ID, defaults to your current dimension.
tempora.command.region.create.success=Created region %s | Bounds: %s -> %s | Midpoint: %s.
tempora.command.region.create.name_taken=A region called '%s' already exists. Names must be unique.
tempora.command.region.create.relative_needs_player=Relative coordinates (~) can only be used by a player.
tempora.command.region.create.no_rules=It has no rules yet, so it won't change what gets logged. %s
tempora.command.region.create.suggest_block_logging=[Log block changes here]
tempora.command.region.create.suggest_block_logging.hover=Fills in the command to turn block change logging ON in this region.

tempora.command.region.list.description=Lists every region with its rules, and briefly draws them in the world around you.
tempora.command.region.list.arg0=Optional. Only list regions in this dimension.
tempora.command.region.list.none=No regions defined.
tempora.command.region.list.entry=Region %s | Bounds: %s -> %s | Midpoint: %s | Created %s by %s.
tempora.command.region.list.no_regions_in_dim=%s (ID %s) has no regions.

tempora.command.region.remove.description=Deletes a region and its rules. Without a name, deletes the region you are standing in.
tempora.command.region.remove.arg0=Optional. Name of the region to delete.
tempora.command.region.remove.removed=Removed region %s | Bounds: %s -> %s | Midpoint: %s.
tempora.command.region.remove.not_in_region=You are not inside a region.
tempora.command.region.remove.ambiguous=You are inside %s regions, click one to remove it:

tempora.command.region.set.description=Turns a logger ON or OFF inside a region, or clears the rule. Where regions overlap, the smallest one with a rule for that logger decides, and ON wins between equally sized regions. Where no region has a rule, the logger's logByDefault config applies.
tempora.command.region.set.arg0=Name of the region.
tempora.command.region.set.arg1=Logger to set the rule for, or all for every logger.
tempora.command.region.set.arg2=on to always log here, off to never log here, clear to remove the rule.
tempora.command.region.set.set=Region %s: %s is now %s.
tempora.command.region.set.set_all=Region %s: all loggers are now %s.
tempora.command.region.set.cleared=Region %s: removed the rule for %s.
tempora.command.region.set.cleared_all=Region %s: removed all rules.
tempora.command.region.set.no_rule=Region %s has no rule for %s, nothing to clear.
tempora.command.region.set.logger_disabled=Note: %s is disabled in the config (isEnabled=false under %s), so it won't log anywhere until that is turned back on.

tempora.command.region.check.description=Shows whether each logger records events where you are standing, and which region or config option decided it.
tempora.command.region.check.arg0=Optional. Only check this logger.
tempora.command.region.check.header=Logging at %s in %s (ID %s):
tempora.command.region.check.entry=%s: %s (%s)
tempora.command.region.check.reason.disabled=disabled in config
tempora.command.region.check.reason.default=no region rule here, using logByDefault from config
tempora.command.region.check.reason.region=rule in region '%s'
tempora.command.region.check.reason.tie=rule in region '%s', which is the same size as '%s' and ON wins ties
