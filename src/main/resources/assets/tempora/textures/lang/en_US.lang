# === Event lines ===
# Every line reads: when, who, did what, where. Colours are set in code, the words here show grey.
message.block_break=%s %s broke %s at %s
message.block_place=%s %s placed %s at %s
message.block_change=%s %s became %s at %s near %s %s
message.block_change.no_player=%s %s became %s at %s %s
message.block_change.closest_player=Closest player was %s blocks away.
message.command_issued=%s %s ran %s at %s
message.command_issued.hover=Click to put this command in your chat box.
message.entity_death.killed=%s %s killed %s at %s
message.entity_death.died=%s %s died (%s) at %s
message.entity_death.unknown=%s %s died at %s
message.entity_position=%s %s was at %s
message.entity_spawn=%s %s spawned at %s
message.explosion=%s Explosion by %s at %s, power %s
message.explosion.unknown=%s Explosion at %s, power %s
message.explosion.destroyed=Destroyed %s blocks.
message.explosion.closest_player=Closest player was %s, %s blocks away.
message.item_use=%s %s used %s at %s
message.item_use.empty_hand=%s %s clicked with an empty hand at %s
message.player_movement=%s %s was at %s
message.inventory.added=%s %s put %s %s in %s at %s
message.inventory.removed=%s %s took %s %s from %s at %s
message.inventory.invalid=Unknown inventory interaction %s in the inventory database. Please report this.
message.weather=%s %s went from %s to %s
message.tps=%s TPS %s, mean tick %sms, worst %sms
message.tempora_wand.checking_pos=Checking %s in %s
message.tempora_wand.nothing_found=Nothing has been logged at this block.
